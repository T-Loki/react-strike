            onClick={onClose}
            className="px-8 py-2.5 bg-amber-600 hover:bg-amber-500 text-black font-bold uppercase tracking-wider rounded-lg shadow-lg"
          >
            Done
          </button>
        </div>
      </div>
    </div>
  );
};
</file>

