<file path="src/index.css">
@import "tailwindcss";

@layer base {
  :root {
    --bg-color: #020617; /* slate-950 */
    --panel-bg: #0f172a; /* slate-900 */
    --text-color: #f1f5f9; /* slate-100 */
    --accent-color: #f59e0b; /* amber-500 */
    --accent-hover: #fbbf24; /* amber-400 */
    --glow-shadow: 0 0 15px rgba(245, 158, 11, 0.3);
    --border-color: rgba(245, 158, 11, 0.3);
  }
  
  :root[data-theme="cyberpunk"] {
    --bg-color: #050505;
    --panel-bg: #111111;
    --text-color: #ecfeff; /* cyan-50 */
    --accent-color: #06b6d4; /* cyan-500 */
    --accent-hover: #d946ef; /* fuchsia-500 */
    --glow-shadow: 0 0 20px rgba(6, 182, 212, 0.6);
    --border-color: rgba(6, 182, 212, 0.4);
  }
  
  :root[data-theme="slate"] {
    --bg-color: #0f172a; /* slate-900 */
    --panel-bg: #1e293b; /* slate-800 */
    --text-color: #f8fafc; /* slate-50 */
    --accent-color: #3b82f6; /* blue-500 */
    --accent-hover: #60a5fa; /* blue-400 */
    --glow-shadow: 0 0 10px rgba(59, 130, 246, 0.2);
    --border-color: rgba(59, 130, 246, 0.3);
  }

  body {
    background-color: var(--bg-color);
    color: var(--text-color);
    @apply font-sans antialiased overflow-hidden transition-colors duration-500;
  }
}

@layer components {
  .theme-btn {
    background-color: transparent;
    border: 1px solid var(--border-color);
    color: var(--accent-color);
    box-shadow: var(--glow-shadow);
    transition: all 0.3s ease;
  }

  .theme-btn:hover {
    background-color: var(--accent-hover);
    color: var(--bg-color);
    box-shadow: 0 0 25px var(--accent-hover);
    transform: translateY(-2px);
  }

  .theme-panel {
    background-color: var(--panel-bg);
    border: 1px solid var(--border-color);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  }
}

@keyframes fade-in {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
.animate-fade-in {
  animation: fade-in 0.3s ease-out forwards;
}

/* Dark Fantasy Scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
::-webkit-scrollbar-track {
  background: #020617; /* bg-slate-950 */
}
::-webkit-scrollbar-thumb {
  background: #334155; /* bg-slate-700 */
  border-radius: 4px;
  border: 1px solid #78350f; /* border-amber-900 */
}
::-webkit-scrollbar-thumb:hover {
  background: #d97706; /* bg-amber-600 */
}

* {
  scrollbar-width: thin;
  scrollbar-color: #334155 #020617;
}

/* ── Custom Volume Sliders ─────────────────────────────────────────── */
.volume-slider {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 6px;
  border-radius: 9999px;
  outline: none;
  cursor: pointer;
  background: linear-gradient(
    to right,
    var(--accent-color) 0%,
    var(--accent-color) var(--slider-pct, 100%),
    rgba(255,255,255,0.08) var(--slider-pct, 100%),
    rgba(255,255,255,0.08) 100%
  );
  transition: opacity 0.2s ease;
}
.volume-slider:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}
/* Webkit thumb */
.volume-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--accent-color);
  box-shadow: 0 0 0 3px rgba(0,0,0,0.6), 0 0 10px var(--accent-color);
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.volume-slider:not(:disabled)::-webkit-slider-thumb:hover {
  transform: scale(1.25);
  box-shadow: 0 0 0 3px rgba(0,0,0,0.6), 0 0 18px var(--accent-color);
}
/* Firefox thumb */
.volume-slider::-moz-range-thumb {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: none;
  background: var(--accent-color);
  box-shadow: 0 0 0 3px rgba(0,0,0,0.6), 0 0 10px var(--accent-color);
  cursor: pointer;
