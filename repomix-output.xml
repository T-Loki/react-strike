                        HP {entry.stats.hp} · DMG {entry.stats.damage} · SPD {entry.stats.speed}
                        {(entry.stats.armor ?? 0) > 0 ? ` · ARM ${entry.stats.armor}` : ''}
                      </p>
                    </div>
                    <div className="flex gap-1 shrink-0">
                      {([1, 5, 10] as const).map(n => (
                        <button
                          key={n}
                          onClick={() => spawnEnemies(entry.stats, n)}
