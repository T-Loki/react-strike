                        item.costType === 'gold' ? 'text-yellow-400' : 'text-cyan-400'
                      }
                    >
                      {item.cost} {item.costType === 'gold' ? 'Gold' : 'Faith'}
                    </span>
                  </div>

                  {!isPurchased ? (
                    <button
                      onClick={() => onBuyShopItem(item.id)}
                      disabled={!canAfford}
                      className={`px-4 py-1.5 rounded-lg font-bold text-xs transition-all ${
                        canAfford
